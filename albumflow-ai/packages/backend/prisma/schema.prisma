// This is your Prisma schema file
// AlbumFlow AI - Database Schema v1.0 MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum LicenseStatus {
  ACTIVE
  TRIAL
  EXPIRED
  SUSPENDED
}

enum PlanType {
  STARTER
  PRO
  STUDIO
  LIFETIME
}

enum WatermarkType {
  TEXT
  LOGO
  COMBINED
}

enum WatermarkPosition {
  TOP_LEFT
  TOP_RIGHT
  CENTER
  BOTTOM_LEFT
  BOTTOM_RIGHT
}

enum CollectionStatus {
  UPLOADING
  PROCESSING
  READY
  AWAITING_CLIENT
  CLIENT_VIEWING
  CONFIRMED
  EXPORTED
  ARCHIVED
  DELETED
}

enum PhotoUploadStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

// ─────────────────────────────────────────────
// 1. USERS TABLE
// ─────────────────────────────────────────────

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password_hash  String
  full_name      String
  phone          String?
  studio_name    String?
  website        String?
  license_key    String?
  license_status LicenseStatus @default(TRIAL)
  plan           PlanType      @default(STARTER)
  is_active      Boolean       @default(true)
  last_login     DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  // Relations
  branding            BrandingSetting?
  google_drive        GoogleDriveConnection?
  collections         Collection[]
  export_jobs         ExportJob[]
  licenses            License[]
  analytics           Analytics?
  activity_logs       ActivityLog[]

  @@map("users")
}

// ─────────────────────────────────────────────
// 2. BRANDING_SETTINGS TABLE
// ─────────────────────────────────────────────

model BrandingSetting {
  id                 String            @id @default(uuid())
  user_id            String            @unique
  logo_url           String?
  watermark_type     WatermarkType     @default(TEXT)
  watermark_text     String?
  watermark_position WatermarkPosition @default(BOTTOM_RIGHT)
  watermark_opacity  Int               @default(30)
  show_phone         Boolean           @default(true)
  show_website       Boolean           @default(true)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("branding_settings")
}

// ─────────────────────────────────────────────
// 3. GOOGLE_DRIVE_CONNECTIONS TABLE
// ─────────────────────────────────────────────

model GoogleDriveConnection {
  id                String   @id @default(uuid())
  user_id           String   @unique
  google_email      String?
  google_account_id String?
  refresh_token     String?
  access_token      String?
  folder_root_id    String?
  is_connected      Boolean  @default(false)
  last_sync         DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("google_drive_connections")
}

// ─────────────────────────────────────────────
// 4. COLLECTIONS TABLE
// ─────────────────────────────────────────────

model Collection {
  id                   String           @id @default(uuid())
  user_id              String
  collection_name      String
  client_name          String
  event_type           String
  event_date           DateTime
  collection_slug      String           @unique
  client_access_token  String           @unique @default(uuid())
  status               CollectionStatus @default(UPLOADING)
  total_photos         Int              @default(0)
  selected_photos      Int              @default(0)
  upload_completed     Boolean          @default(false)
  confirmed_at         DateTime?
  expires_at           DateTime?
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  photos           Photo[]
  photo_selections PhotoSelection[]
  client_sessions  ClientSession[]
  export_jobs      ExportJob[]
  activity_logs    ActivityLog[]

  @@index([user_id])
  @@index([status])
  @@map("collections")
}

// ─────────────────────────────────────────────
// 5. PHOTOS TABLE
// ─────────────────────────────────────────────

model Photo {
  id                String            @id @default(uuid())
  collection_id     String
  original_filename String
  file_size         BigInt
  file_type         String
  s3_original_key   String
  s3_preview_key    String?
  width             Int?
  height            Int?
  checksum          String?
  upload_status     PhotoUploadStatus @default(UPLOADING)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  collection       Collection       @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  photo_selections PhotoSelection[]

  @@index([collection_id])
  @@map("photos")
}

// ─────────────────────────────────────────────
// 6. PHOTO_SELECTIONS TABLE
// ─────────────────────────────────────────────

model PhotoSelection {
  id                String   @id @default(uuid())
  collection_id     String
  photo_id          String
  selected          Boolean  @default(true)
  selected_at       DateTime @default(now())
  client_session_id String?
  created_at        DateTime @default(now())

  collection    Collection    @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  photo         Photo         @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  client_session ClientSession? @relation(fields: [client_session_id], references: [id])

  @@unique([collection_id, photo_id])
  @@index([photo_id])
  @@index([collection_id])
  @@map("photo_selections")
}

// ─────────────────────────────────────────────
// 7. CLIENT_SESSIONS TABLE
// ─────────────────────────────────────────────

model ClientSession {
  id             String   @id @default(uuid())
  collection_id  String
  session_token  String   @unique @default(uuid())
  device_type    String?
  browser        String?
  ip_address     String?
  started_at     DateTime @default(now())
  last_activity  DateTime @default(now())
  is_confirmed   Boolean  @default(false)

  collection       Collection       @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  photo_selections PhotoSelection[]

  @@map("client_sessions")
}

// ─────────────────────────────────────────────
// 8. EXPORT_JOBS TABLE
// ─────────────────────────────────────────────

model ExportJob {
  id               String          @id @default(uuid())
  collection_id    String
  user_id          String
  status           ExportJobStatus @default(PENDING)
  total_files      Int             @default(0)
  completed_files  Int             @default(0)
  google_folder_id String?
  started_at       DateTime?
  completed_at     DateTime?
  error_message    String?
  created_at       DateTime        @default(now())

  collection Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([collection_id])
  @@map("export_jobs")
}

// ─────────────────────────────────────────────
// 9. LICENSES TABLE
// ─────────────────────────────────────────────

model License {
  id          String        @id @default(uuid())
  user_id     String
  license_key String        @unique
  plan        PlanType
  start_date  DateTime
  expiry_date DateTime
  status      LicenseStatus @default(ACTIVE)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("licenses")
}

// ─────────────────────────────────────────────
// 10. ANALYTICS TABLE
// ─────────────────────────────────────────────

model Analytics {
  id                 String   @id @default(uuid())
  user_id            String   @unique
  total_collections  Int      @default(0)
  total_uploads      BigInt   @default(0)
  total_selected     BigInt   @default(0)
  total_storage_used BigInt   @default(0)
  last_calculated    DateTime @default(now())
  created_at         DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("analytics")
}

// ─────────────────────────────────────────────
// 11. ACTIVITY_LOGS TABLE
// ─────────────────────────────────────────────

model ActivityLog {
  id            String   @id @default(uuid())
  user_id       String
  collection_id String?
  action        String
  description   String?
  ip_address    String?
  created_at    DateTime @default(now())

  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collection_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@map("activity_logs")
}
