{
  "name": "@albumflow/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "AlbumFlow AI Desktop Application",
  "author": "AlbumFlow AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "ai.albumflow.desktop",
    "productName": "AlbumFlow AI",
    "copyright": "Copyright © 2024 AlbumFlow AI",
    "compression": "store",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      {
        "from": "../web/dist",
        "to": "web-dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "zip",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "useZip": true
    },
    "electronVersion": "31.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.2.1"
  },
  "devDependencies": {
    "electron": "31.0.1",
    "electron-builder": "24.13.3"
  }
}
